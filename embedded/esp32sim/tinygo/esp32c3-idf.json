{
  "inherits": ["riscv32"],
  "features": "+32bit,+c,+m,+zmmul,-relax",
  "build-tags": ["esp32c3", "esp", "espradio", "esp32c3_generic"],
  "serial": "uart",
  "rtlib": "compiler-rt",
  "libc": "picolibc",
  "default-stack-size": 8192,
  "cflags": ["-march=rv32imc"],
  "linkerscript": "targets/esp32c3-idf.ld",
  "extra-files": ["targets/esp32c3-idf.S"],
  "binary-format": "esp32c3"
}
