{
  "inherits": ["riscv32"],
  "features": "+32bit,+a,+c,+m,+zaamo,+zalrsc,+zmmul,-relax",
  "build-tags": ["esp32c6", "esp", "xiao_esp32c6"],
  "serial": "uart",
  "rtlib": "compiler-rt",
  "libc": "picolibc",
  "default-stack-size": 8192,
  "linkerscript": "targets/esp32c6-idf.ld",
  "extra-files": ["targets/esp32c6-idf.S"],
  "binary-format": "esp32c6"
}
